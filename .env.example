# Copy to .env only for local configuration. Never commit populated secrets.
# Foundation serves contracts and explicit stubs; it cannot run a live evaluation.
CQA_MODE=production
CQA_EVALUATOR=production
CQA_DATA_DIR=data/private
CQA_DATABASE_URL=sqlite:///data/private/cqa.sqlite3
CQA_DATASET_URL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Future runtime limits. The pinned EvaluatorProfile is authoritative for a job.
CQA_IMPORT_MAX_BYTES=10485760
CQA_AUDIO_ALLOWED_HOSTS=
CQA_SQLITE_BUSY_TIMEOUT_MS=5000
