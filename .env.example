# Copy to .env only for local configuration. Never commit populated secrets.
# The default is real-provider mode. Missing profiles/keys never enable test answers.
# For isolated tests set BOTH modes to test and use a separate data directory/DB.
CQA_MODE=production
CQA_EVALUATOR=production
CQA_TEST_SCENARIO=complete
CQA_DATA_DIR=data/private
CQA_DATABASE_URL=sqlite:///data/private/cqa.sqlite3
# Optional: defaults to <CQA_DATA_DIR>/config, containing profiles/ and corpora/.
# CQA_CONFIG_DIR=data/private/config
# Optional explicit default in the launch dialog (must match an installed profile).
# CQA_DEFAULT_EVALUATOR_PROFILE=live-xerosharc-quality-v1
CQA_SEED_ORIGINAL_CHECKLIST=true

# Private organizer URL and provider keys: fill only in a local .env/environment.
CQA_DATASET_URL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XEROSHARC_API_KEY=
XEROSHARC_BASE_URL=https://xerosharc.site/v1
BASISWEB_API_KEY=

# One managed executor per local SQLite DB. Disable this for a standalone worker.
CQA_WORKER_ENABLED=true
CQA_WORKER_CONCURRENCY=2
CQA_WORKER_POLL_SECONDS=0.5
CQA_LEASE_SECONDS=60
# Finish/persist an already obtained result after deadline; no new provider calls.
CQA_DEADLINE_GRACE_SECONDS=10
CQA_RETRY_BASE_SECONDS=5
CQA_RETRY_MAX_SECONDS=60

# Runtime import/audio/storage limits. Job AI limits live in its pinned profile.
CQA_IMPORT_MAX_BYTES=10485760
CQA_IMPORT_MAX_RECORDS=1000
CQA_ORGANIZER_TIMEOUT_SECONDS=30
CQA_AUDIO_ALLOWED_HOSTS=
CQA_AUDIO_MAX_BYTES=209715200
CQA_AUDIO_TIMEOUT_SECONDS=30
CQA_SQLITE_BUSY_TIMEOUT_MS=5000
CQA_SQLITE_SYNCHRONOUS=FULL
